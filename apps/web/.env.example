# Local defaults for the Next.js public web app.
# For Vercel staging, replace these with the staging FastAPI and web URLs.
JUPR_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_JUPR_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_JUPR_WEB_BASE_URL=http://localhost:3000

# Vercel preview deployments are forced to this server-side API target by
# next.config.js. The default is the dedicated Fly staging app below.
JUPR_STAGING_API_BASE_URL=https://juprleagues-api-staging.fly.dev
NEXT_PUBLIC_STAGING_SUPABASE_URL=https://your-staging-project.supabase.co
NEXT_PUBLIC_STAGING_SUPABASE_ANON_KEY=your-staging-public-anon-key

# Production public web URL after custom-domain verification:
# NEXT_PUBLIC_JUPR_WEB_BASE_URL=https://pickleballclubsandwich.com

# Feature-flag note:
# - FastAPI write guard uses JUPR_ENABLE_NEXT_ADMIN_SCORE_ENTRY
# - Browser UI visibility uses NEXT_PUBLIC_JUPR_ENABLE_NEXT_ADMIN_SCORE_ENTRY
# Keep both disabled unless explicitly testing the staging-only admin score-entry MVP.
JUPR_ENABLE_NEXT_ADMIN_SCORE_ENTRY=0
NEXT_PUBLIC_JUPR_ENABLE_NEXT_ADMIN_SCORE_ENTRY=0

# Optional environment label. Set to "staging" in Vercel staging/preview deployments
# to show the STAGING badge in the shell.
NEXT_PUBLIC_JUPR_ENV=staging

# Smoke-check variables are not used by the Next runtime. They are read by
# scripts/smoke_public_web.py and the Staging Smoke GitHub Actions workflow.
# STAGING_JUPR_API_BASE_URL=https://your-staging-api.example
# STAGING_WEB_BASE_URL=https://your-vercel-preview.example
# JUPR_SMOKE_ARGS=--allow-live-unconfigured
