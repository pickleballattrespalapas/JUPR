FROM python:3.11-slim

ARG JUPR_DEPLOYMENT_GIT_SHA=unknown

LABEL org.opencontainers.image.revision="${JUPR_DEPLOYMENT_GIT_SHA}"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PORT=8080 \
    JUPR_IMAGE_BUILD_GIT_SHA="${JUPR_DEPLOYMENT_GIT_SHA}"

WORKDIR /app

COPY requirements.txt ./requirements.txt
COPY services/api/requirements.txt ./services/api/requirements.txt

RUN python -m pip install --upgrade pip setuptools wheel \
    && pip install -r requirements.txt \
    && pip install -r services/api/requirements.txt

COPY . .

EXPOSE 8080

CMD ["sh", "-c", "exec uvicorn services.api.main:app --host 0.0.0.0 --port ${PORT:-8080} --proxy-headers"]
